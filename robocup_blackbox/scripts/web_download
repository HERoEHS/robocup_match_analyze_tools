#!/usr/bin/env python3
"""Blackbox File Download — ROS2 node + HTTP server.

Reads output_dir from record_profile.yaml (via config_path parameter) and
serves a web UI for browsing and downloading .mcap sessions.

Usage:
    ros2 run robocup_blackbox web_download
    ros2 run robocup_blackbox web_download --ros-args -p port:=8767
    ros2 run robocup_blackbox web_download --ros-args -p config_path:=/path/to/record_profile.yaml
    ros2 run robocup_blackbox web_download --ros-args -p output_dir:=~/blackbox_data
"""

import os
import re
import threading
import time
import urllib.parse
import zipfile
from http.server import BaseHTTPRequestHandler, HTTPServer
from socketserver import ThreadingMixIn
from pathlib import Path
from typing import List, Tuple

import rclpy
import yaml
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node


# ── Utilities ─────────────────────────────────────────────────────────────────

def _expand(path: str) -> str:
    return str(Path(path).expanduser().resolve())


def _human(n: int) -> str:
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024:
            return f'{n:.1f} {unit}'
        n /= 1024
    return f'{n:.1f} TB'


def _safe(base: str, path: str) -> bool:
    """Return True only if path resolves inside base (prevents traversal)."""
    real_base = os.path.realpath(base)
    real_path = os.path.realpath(path)
    return real_path == real_base or real_path.startswith(real_base + os.sep)


def _load_output_dir(config_path: str) -> str:
    with open(config_path) as f:
        cfg = yaml.safe_load(f)
    return _expand(cfg.get('output_dir', '~/blackbox_data'))


def _find_default_config() -> str:
    try:
        from ament_index_python.packages import get_package_share_directory
        pkg = get_package_share_directory('robocup_blackbox')
        return os.path.join(pkg, 'config', 'record_profile.yaml')
    except Exception:
        return ''


def _scan_dir_files(dirpath: str) -> List[Tuple[str, float, int]]:
    """Return (filepath, mtime, size) for regular files inside dirpath."""
    result = []
    try:
        for e in os.scandir(dirpath):
            if e.is_file():
                st = e.stat()
                result.append((e.path, st.st_mtime, st.st_size))
    except OSError:
        pass
    return result


def _sessions(output_dir: str) -> List[dict]:
    """Find all rosbag2 session directories (*.mcap/) recursively and group splits.

    Scans output_dir at any depth.  Directories that end in .mcap or .mcap.N
    are treated as session parts; os.walk does not descend into them.
    """
    if not os.path.isdir(output_dir):
        return []

    # key = (rel_parent_dir, base_name)  →  [(split_idx, dirname, dirpath)]
    by_base: dict = {}
    for dirpath, dirnames, _ in os.walk(output_dir):
        session_dirs, recurse_dirs = [], []
        for d in dirnames:
            if d.startswith('.'):
                continue
            if d.endswith('.mcap') or re.match(r'.+\.mcap\.\d+$', d):
                session_dirs.append(d)
            else:
                recurse_dirs.append(d)
        dirnames[:] = recurse_dirs  # don't descend into .mcap dirs

        rel_parent = os.path.relpath(dirpath, output_dir)
        for dname in session_dirs:
            full_path = os.path.join(dirpath, dname)
            if dname.endswith('.mcap'):
                base_name, split_idx = dname[:-5], 0
            else:
                m = re.match(r'^(.+)\.mcap\.(\d+)$', dname)
                base_name, split_idx = m.group(1), int(m.group(2))
            key = (rel_parent, base_name)
            by_base.setdefault(key, []).append((split_idx, dname, full_path))

    now = time.time()
    result = []
    for (rel_parent, base_name), parts in by_base.items():
        parts.sort(key=lambda x: x[0])
        dir_list: List[Tuple[str, str]] = [(dname, dp) for _, dname, dp in parts]

        total_size, mtime = 0, 0.0
        for _, dp in dir_list:
            for fp, mt, sz in _scan_dir_files(dp):
                total_size += sz
                mtime = max(mtime, mt)

        folder = '' if rel_parent == '.' else rel_parent
        # base is the URL key: folder/name (folder may be empty for root sessions)
        base_key = (folder + '/' if folder else '') + base_name

        result.append({
            'base': base_key,
            'name': base_name,
            'folder': folder,
            'dirs': dir_list,
            'size': total_size,
            'mtime': mtime,
            'date': time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(mtime)) if mtime else '—',
            'recording': mtime > 0 and (now - mtime) < 30,
        })

    result.sort(key=lambda s: s['mtime'], reverse=True)
    return result


# ── Streaming zip ─────────────────────────────────────────────────────────────

class _StreamSink:
    """Non-seekable write-only wrapper for streaming ZIP without buffering.

    Python's zipfile falls back to data-descriptor mode when seekable() is
    False, tracking offsets via tell().  We satisfy that contract while
    forwarding bytes directly to the HTTP response socket.
    """
    def __init__(self, wfile):
        self._f = wfile
        self._pos = 0

    def write(self, data: bytes) -> int:
        self._f.write(data)
        self._pos += len(data)
        return len(data)

    def tell(self) -> int:
        return self._pos

    def seekable(self) -> bool:
        return False

    def flush(self):
        pass


