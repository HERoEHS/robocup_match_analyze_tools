_JS = """
function updateBtn() {
    var n = document.querySelectorAll('input[name="sessions"]:checked').length;
    var btn = document.getElementById('zip-btn');
    btn.disabled = n === 0;
    btn.textContent = n > 0
        ? 'Download ' + n + ' Session(s) as ZIP'
        : 'Download Selected (ZIP)';
}
function toggleAll() {
    var boxes = document.querySelectorAll('input[name="sessions"]');
    var all = Array.from(boxes).every(function(b) { return b.checked; });
    boxes.forEach(function(b) { b.checked = !all; });
    updateBtn();
}
document.querySelectorAll('input[name="sessions"]').forEach(function(b) {
    b.addEventListener('change', updateBtn);
});
"""


def _render_page(output_dir: str, sessions: List[dict], port: int) -> str:
    now = time.strftime('%Y-%m-%d %H:%M:%S')

    if not sessions:
        msg = (
            f'Output directory not found:<br><code>{output_dir}</code>'
            if not os.path.isdir(output_dir)
            else 'No .mcap sessions found in output directory.'
        )
        table_html = f'<div class="empty">{msg}</div>'
    else:
        rows = []
        for s in sessions:
            base_enc = urllib.parse.quote(s['base'], safe='')
            badge = '<span class="badge-rec">REC</span>' if s['recording'] else ''
            folder_cell = f'<span style="color:#888;font-size:.82rem">{s["folder"]}</span>' if s['folder'] else ''
            rows.append(
                f'<tr>'
                f'<td style="text-align:center;width:40px">'
                f'<input type="checkbox" name="sessions" value="{s["base"]}">'
                f'</td>'
                f'<td class="name">{s["name"]}{badge}</td>'
                f'<td class="hide-sm" style="color:#888;font-size:.82rem">{s["folder"]}</td>'
                f'<td class="date hide-sm">{s["date"]}</td>'
                f'<td class="parts hide-sm">{len(s["dirs"])}</td>'
                f'<td class="size">{_human(s["size"])}</td>'
                f'<td class="actions">'
                f'<a href="/download?session={base_enc}">'
                f'<button type="button" class="btn btn-dl">Download</button>'
                f'</a>'
                f'</td>'
                f'</tr>'
            )
        table_html = (
            '<table>'
            '<thead><tr>'
            '<th></th><th>Session</th>'
            '<th class="hide-sm">Folder</th>'
            '<th class="hide-sm">Date (local)</th>'
            '<th class="hide-sm" style="text-align:center">Parts</th>'
            '<th style="text-align:right">Size</th>'
            '<th style="text-align:right">Download</th>'
            '</tr></thead>'
            f'<tbody>{"".join(rows)}</tbody>'
            '</table>'
        )

    return (
        '<!DOCTYPE html><html lang="en"><head>'
        '<meta charset="UTF-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1.0">'
        '<title>Blackbox Download</title>'
        f'<style>{_CSS}</style>'
        '</head><body><div class="container">'
        '<h1>Blackbox Download</h1>'
        f'<div class="subtitle">{output_dir}</div>'
        '<form id="form" action="/download-zip" method="post">'
        '<div class="toolbar">'
        '<div style="display:flex;gap:8px;align-items:center;">'
        '<button type="button" class="btn btn-secondary" onclick="toggleAll()">Select All</button>'
        f'<span class="count">{len(sessions)} session(s)</span>'
        '</div>'
        '<div style="display:flex;gap:8px;">'
        '<a href="/"><button type="button" class="btn btn-secondary">Refresh</button></a>'
        '<button type="submit" id="zip-btn" class="btn btn-primary" disabled>'
        'Download Selected (ZIP)'
        '</button>'
        '</div>'
        '</div>'
        f'<div class="card">{table_html}</div>'
        '</form>'
        f'<div class="footer">Port {port} &bull; {now}</div>'
        f'</div><script>{_JS}</script></body></html>'
    )


# ── HTTP handler ───────────────────────────────────────────────────────────────

class _QuietHTTPServer(ThreadingMixIn, HTTPServer):
    """Threaded HTTPServer that silently drops connection-reset errors."""
    daemon_threads = True  # worker threads exit when main thread exits

    def handle_error(self, request, client_address):
        import sys
        if isinstance(sys.exc_info()[1], (ConnectionResetError, BrokenPipeError)):
            return
        super().handle_error(request, client_address)


class DownloadHandler(BaseHTTPRequestHandler):
    output_dir: str = ''
    port: int = 8767

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(parsed.query)

        if parsed.path == '/':
            sessions = _sessions(self.output_dir)
            html = _render_page(self.output_dir, sessions, self.port)
            data = html.encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        elif parsed.path == '/download':
            base = qs.get('session', [None])[0]
            if not base:
                self._error(400, 'Missing session parameter')
                return
            self._download_session(base)

        else:
            self._error(404, 'Not found')

    def do_POST(self):
        if self.path != '/download-zip':
            self._error(404, 'Not found')
            return
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode()
        params = urllib.parse.parse_qs(body)
        bases = params.get('sessions', [])
        if not bases:
            self._error(400, 'No sessions selected')
            return
        self._download_multi(bases)

    def _download_session(self, base: str):
        if not self._valid_base(base):
            return
        sessions = _sessions(self.output_dir)
        session = next((s for s in sessions if s['base'] == base), None)
        if not session:
            self._error(404, f'Session not found: {base}')
            return

        self._stream_zip(base, self._collect_pairs(session['dirs']))

    def _download_multi(self, bases: List[str]):
        for b in bases:
            if not self._valid_base(b, respond=False):
                self._error(400, f'Invalid session name: {b}')
                return
        sessions = _sessions(self.output_dir)
        by_base = {s['base']: s for s in sessions}
        all_pairs: List[Tuple[str, str]] = []
        for b in bases:
            s = by_base.get(b)
            if s:
                all_pairs.extend(self._collect_pairs(s['dirs']))
        if not all_pairs:
            self._error(404, 'No files found for selected sessions')
            return
        self._stream_zip(f'blackbox_{time.strftime("%Y%m%d_%H%M%S")}', all_pairs)

    def _collect_pairs(self, dir_list: List[Tuple[str, str]]) -> List[Tuple[str, str]]:
        pairs = []
        for dirname, dirpath in dir_list:
            if not _safe(self.output_dir, dirpath):
                continue
            for fp, _, _ in _scan_dir_files(dirpath):
                if _safe(self.output_dir, fp):
                    pairs.append((dirname + '/' + os.path.basename(fp), fp))
        return pairs

    def _stream_zip(self, zip_name: str, file_pairs: List[Tuple[str, str]]):
        safe_pairs = [(arc, fp) for arc, fp in file_pairs if _safe(self.output_dir, fp)]
        if not safe_pairs:
            self._error(403, 'Access denied')
            return
        safe_name = re.sub(r'["\\/]', '_', zip_name)
        try:
            self.send_response(200)
            self.send_header('Content-Type', 'application/zip')
            self.send_header('Content-Disposition', f'attachment; filename="{safe_name}.zip"')
            self.send_header('Connection', 'close')
            self.end_headers()
            sink = _StreamSink(self.wfile)
            with zipfile.ZipFile(sink, 'w', zipfile.ZIP_STORED, allowZip64=True) as zf:
                for arcname, filepath in safe_pairs:
                    zf.write(filepath, arcname)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _valid_base(self, base: str, respond: bool = True) -> bool:
        # Prevent path traversal and null bytes; allow / for subfolder sessions
        if '\x00' in base or '\\' in base or '..' in base.split('/'):
            if respond:
                self._error(400, 'Invalid session name')
            return False
        return True

    def _error(self, code: int, msg: str):
        body = msg.encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'text/plain; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def address_string(self):
        # Skip reverse DNS lookup — avoids multi-second delay on external clients
        return self.client_address[0]

    def log_message(self, fmt, *args):
        ts = time.strftime('%H:%M:%S')
        print(f'[{ts}] {fmt % args}')


# ── ROS2 node ─────────────────────────────────────────────────────────────────

class WebDownloadNode(Node):
    def __init__(self):
        super().__init__('web_download')

        self.declare_parameter('config_path', '')
        self.declare_parameter('output_dir', '')
        self.declare_parameter('port', 8767)

        config_path = self.get_parameter('config_path').get_parameter_value().string_value
        output_dir_param = self.get_parameter('output_dir').get_parameter_value().string_value
        port = self.get_parameter('port').get_parameter_value().integer_value

        if output_dir_param:
            output_dir = _expand(output_dir_param)
        else:
            if not config_path:
                config_path = _find_default_config()
            if not config_path or not os.path.isfile(config_path):
                self.get_logger().fatal(
                    'Cannot find record_profile.yaml. '
                    'Set config_path or output_dir parameter.'
                )
                raise RuntimeError('Missing config')
            output_dir = _load_output_dir(config_path)
            self.get_logger().info(f'Config: {config_path}')

        DownloadHandler.output_dir = output_dir
        DownloadHandler.port = port

        # HTTPServer sets SO_REUSEADDR, so the same port is reusable immediately
        # after restart without waiting for TIME_WAIT to expire.
        try:
            self._server = _QuietHTTPServer(('', port), DownloadHandler)
        except OSError as e:
            self.get_logger().fatal(f'Port {port} unavailable: {e}')
            raise RuntimeError(f'Port {port} unavailable') from e
        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
        self._thread.start()

        self.get_logger().info(f'Output dir : {output_dir}')
        self.get_logger().info(f'Download UI: http://localhost:{port}')
        self.get_logger().info(f'             http://192.168.10.2:{port}')

    def destroy_node(self):
        self._server.shutdown()
        super().destroy_node()


# ── Entry point ────────────────────────────────────────────────────────────────

def main():
    rclpy.init()
    try:
        node = WebDownloadNode()
    except RuntimeError:
        rclpy.shutdown()
        return 1

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    except ExternalShutdownException:
        pass
    finally:
        node.destroy_node()
        try:
            rclpy.shutdown()
        except Exception:
            pass
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
